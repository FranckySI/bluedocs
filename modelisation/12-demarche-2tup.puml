@startuml
title BlueDocs — démarche de conception 2TUP
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

package "Branche fonctionnelle" as Fonctionnelle {
  artifact "Périmètre et acteurs" as Acteurs
  artifact "Exigences et cas\nd'utilisation" as UseCases
  artifact "Modèle du domaine\net parcours métier" as Domaine
  Acteurs --> UseCases
  UseCases --> Domaine
}

package "Branche technique" as Technique {
  artifact "Architecture Laravel\net composants" as Architecture
  artifact "Schéma MySQL\net persistance" as Persistance
  artifact "Contraintes et écarts\nd'environnement" as Contraintes
  Architecture --> Persistance
  Persistance --> Contraintes
}

artifact "Conception convergente\nséquences, activités,\ntraçabilité et validation" as Convergence
artifact "Réalisation et tests" as Realisation

Domaine --> Convergence
Contraintes --> Convergence
Convergence --> Realisation
@enduml
