@startuml
title BlueDocs — séquence de gestion d'un document
autonumber
skinparam shadowing false

actor "Utilisateur authentifié" as Editeur
boundary "Navigateur" as Browser
control "Route + middleware auth" as Route
control DocumentController as Controller
entity Document as Model
database MySQL as DB
collections "Journal Laravel" as Log

group Création
  Editeur -> Browser : Soumet titre, contenu,\nslug facultatif
  Browser -> Route : POST /documents
  Route -> Route : Vérifier auth
  Route -> Controller : store(Request)
  Controller -> Controller : Valider les champs
  alt Entrées invalides
    Controller --> Browser : Erreurs de validation
  else Entrées valides
    Controller -> Controller : Générer le slug si absent
    Controller -> Model : create(title, slug, content, user_name)
    Model -> DB : INSERT documents
    DB --> Model : Document créé
    Controller -> Log : Document created (id, slug, actor_id)
    Controller --> Browser : Redirection vers le sommaire
  end
end

group Mise à jour
  Editeur -> Browser : Soumet titre et contenu
  Browser -> Route : PUT /documents/{document}
  Route -> Route : Vérifier auth + résolution du modèle
  Route -> Controller : update(Request, Document)
  Controller -> Controller : Valider titre et contenu
  Controller -> Model : update(title, content,\nupdated_by, user_name)
  Model -> DB : UPDATE documents
  Controller -> Log : Document updated (id, slug, actor_id)
  Controller --> Browser : Redirection vers le sommaire
end

group Consultation et suppression
  Editeur -> Browser : Ouvre un slug / demande suppression
  Browser -> Controller : GET /{document} ou DELETE /documents/{document}
  alt Consultation
    Controller -> DB : Chercher Document par slug
    alt Document absent
      Controller --> Browser : Vue avec document virtuel,\nsans insertion
    else Document trouvé
      Controller --> Browser : Vue du document
    end
  else Suppression authentifiée
    Controller -> DB : DELETE documents
    Controller -> Log : Document deleted (id, slug, actor_id)
    Controller --> Browser : Redirection vers la liste
  end
end
@enduml
