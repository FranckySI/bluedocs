@startuml
title BlueDocs — séquence de recherche documentaire
autonumber
skinparam shadowing false

actor Visiteur
boundary Navigateur as Browser
control "DocumentSearchController" as Search
entity Document as Model
database MySQL as DB

Visiteur -> Browser : Saisit q
Browser -> Search : GET /recherche?q=...
Search -> Search : Valider q (max. 100 caractères)\nnormaliser et extraire les mots-clés
alt Requête vide
  Search --> Browser : Vue sans résultats
else Requête non vide sans mot-clé
  Search --> Browser : Vue sans résultats
else Mots-clés disponibles
  loop Chaque mot-clé
    Search -> Model : Ajouter les critères titre/contenu\net variantes de casse
  end
  Search -> DB : Exécuter recherche ordonnée,\n15 éléments par page
  DB --> Search : Documents de la page + total
  Search -> Search : Générer un extrait pour chaque résultat
  Search --> Browser : Vue docs.search + pagination
end
@enduml
