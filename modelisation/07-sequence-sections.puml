@startuml
title BlueDocs — séquence de gestion d'une section
autonumber
skinparam shadowing false

actor "Utilisateur authentifié" as User
boundary Navigateur as Browser
control "Route + middleware auth" as Route
control SectionController as Controller
entity Section as Model
database MySQL as DB
collections "Journal Laravel" as Log

alt Création
  User -> Browser : Saisit le titre
  Browser -> Route : POST /sommaire/sections
  Route -> Route : Vérifier auth
  Route -> Controller : store(Request)
  Controller -> Controller : Valider title
  Controller -> Model : create(title)
  Model -> DB : INSERT sections
  Controller -> Log : section created (id, actor_id)
  Controller --> Browser : Redirection vers le sommaire
else Suppression
  User -> Browser : Confirme la suppression
  Browser -> Route : DELETE /sommaire/sections/{section}
  Route -> Route : Vérifier auth + résoudre Section
  Route -> Controller : destroy(Request, Section)
  Controller -> DB : DELETE sections
  Controller -> Log : section deleted (id, actor_id)
  Controller --> Browser : Redirection vers le sommaire
end

note over Model, DB
  L'association Section-Document passe par document_section
  dans le code et la migration. Cette table est absente
  du schéma MySQL observé.
end note
@enduml
