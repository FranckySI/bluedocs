@startuml
title BlueDocs — déploiement logique
skinparam shadowing false

node "Poste utilisateur" {
  artifact "Navigateur web"
}

node "Environnement d'exécution Laravel\n(hébergement non spécifié)" as AppHost {
  artifact "Serveur HTTP"
  node "Runtime PHP 8.5" {
    artifact "Application Laravel 13.31"
    artifact "Vues Blade et ressources web"
  }
}

database "MySQL\n(base configurée)" as MySQL

"Navigateur web" --> "Serveur HTTP" : HTTPS/HTTP
"Serveur HTTP" --> "Application Laravel 13.31" : requêtes PHP
"Application Laravel 13.31" --> MySQL : connexion SQL
"Vues Blade et ressources web" --> "Navigateur web" : HTML / ressources

note bottom of AppHost
  Représentation logique uniquement :
  le dépôt ne précise ni fournisseur cloud,
  ni topologie réseau, ni configuration
  de production.
end note
@enduml
