
@startuml
title BlueDocs - Cas d'utilisation
left to right direction
skinparam packageStyle rectangle

actor Visiteur
actor "Éditeur\n(role = editeur)" as Editeur
actor "Administrateur\n(role = admin)" as Admin

Admin --|> Editeur
Editeur --|> Visiteur

rectangle BlueDocs {
  usecase "Consulter l'accueil" as UC_Accueil
  usecase "Lire le sommaire\net un document" as UC_Lire
  usecase "Rechercher des documents" as UC_Recherche
  usecase "Authentification" as UC_Auth
  usecase "Vérifier\nl'authentification" as UC_VerifierAuth
  usecase "Consulter le\ntableau de bord" as UC_Dashboard
  usecase "Créer un document" as UC_Creer
  usecase "Modifier un document" as UC_Modifier
  usecase "Supprimer un document" as UC_Supprimer
  usecase "Gérer son profil" as UC_Profil
  usecase "Créer un compte" as UC_Compte
  usecase "Supprimer un compte" as UC_CompteSupprimer

  UC_Dashboard ..> UC_VerifierAuth : <<include>>
  UC_Creer ..> UC_VerifierAuth : <<include>>
  UC_Modifier ..> UC_VerifierAuth : <<include>>
  UC_Supprimer ..> UC_VerifierAuth : <<include>>
  UC_Profil ..> UC_VerifierAuth : <<include>>
  UC_Compte ..> UC_VerifierAuth : <<include>>
  UC_CompteSupprimer ..> UC_VerifierAuth : <<include>>
}

Visiteur --> UC_Accueil
Visiteur --> UC_Lire
Visiteur --> UC_Recherche

Editeur --> UC_Auth
Editeur --> UC_Dashboard
Editeur --> UC_Creer
Editeur --> UC_Modifier
Editeur --> UC_Supprimer
Editeur --> UC_Profil

Admin --> UC_Compte
Admin --> UC_CompteSupprimer

note bottom of UC_VerifierAuth
  Vérifie que la session utilisateur
  est valide avant l'opération.
end note


@enduml
